{
  "name": "my-app",
  "version": "1.0.0",
  "module": "index.ts",
  "author": "Romero, Ryan Nicolas, M.",
  "description": "String Reverser App",
  "main": "main.js",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/figlet": "^1.7.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.stringreverser.app",
    "productName": "StringReverser",
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "files": [
      "assets/**/*",
      "main.js"
    ]
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "figlet": "^1.12.0"
  }
}
